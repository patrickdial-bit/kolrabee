# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
# Marketing Engine (Leads / Prospects / Market Intel) is parked while the
# product focuses on subcontractor dispatch. Set to "on" to bring the module
# back, then flip tenants.marketing_enabled per company.
NEXT_PUBLIC_MARKETING_ENGINE=off

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_GROWTH_PRICE_ID=price_your-growth-price-id
STRIPE_OPERATOR_PRICE_ID=price_your-operator-price-id

# Resend (email)
RESEND_API_KEY=re_your-resend-api-key

# Cloud backup — Google Drive (optional; backup falls back to local ZIP without it)
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud, enable the
# Drive API, and add the redirect URI: <site-url>/api/integrations/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# 32-byte key that encrypts stored OAuth refresh tokens. Generate: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=your-64-char-hex-key
# Secret for the nightly backup cron. Vercel sends it as a Bearer token on cron
# invocations when set. Generate: openssl rand -hex 16
CRON_SECRET=your-cron-secret
